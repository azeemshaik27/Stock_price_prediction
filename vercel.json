{
  "version": 2,
  "builds": [
    {
      "src": "stock-prediction/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "stock-prediction/app.py"
    }
  ],
  "env": {
    "FLASK_ENV": "production",
    "FLASK_DEBUG": "0",
    "TRAIN_ON_DEMAND": "0"
  }
}
